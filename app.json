{
  "expo": {
    "name": "Statement to Excel Kenya",
    "slug": "statement-to-excel-kenya",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "statementexcelke",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.mpesa.statementtoexcel",
      "adaptiveIcon": {
        "backgroundColor": "#F0FFF4"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "./plugins/withPdfJs",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
